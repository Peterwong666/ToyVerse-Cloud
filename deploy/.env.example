# ============================================================
# ToyVerse Cloud — **生产部署清单**（不是开发模板）
#
# 与根目录 `.env.example` 的分工
# ------------------------------
# * `.env.example`（根目录）—— **开发模板**：`make env` 复制它为 `.env`，
#   默认 `APP_ENV=development` + 演示种子数据，为的是「克隆即跑」。
# * 本文件 —— **上生产前要逐项确认的清单**：哪些值必须换、哪些开关必须关、
#   以及容器编排专属的变量。它不用于直接复制（没有完整变量表），
#   而是作为 `.env` 的「生产差异核对单」。
#
# 用法：`make env` 生成 `.env` → 编辑 `.env` → 对照本清单逐项确认 → `make up`
#       （或 `make up-full` 连 PostgreSQL 一起起）
#
# 为什么这些项必须显式确认（而不是给默认值「跑起来再说」）
# ------------------------------------------------------
# 本项目的原型把 `admin@2024` 这类弱口令写进 `.env` 并进了仓库，
# 早期实现还把密钥明文下发到前端（见 `todolist.md` 附录 B）。
# 这些问题的共同点是**功能上完全正常**——只有靠启动期硬校验 + 上生产前的
# 显式确认才能挡住。因此 `app/core/config.py` 的 `validate_security()`
# 采用「**不安全就拒绝启动**」而不是「打条警告继续跑」。
# ============================================================

# ---------------------------------------------------------------------------
# 一、必须修改的项（保持默认值会让服务**拒绝启动**）
# ---------------------------------------------------------------------------

# 生产模式：会触发下面全部硬校验
APP_ENV=production

# 调试必须关闭
DEBUG=false

# 演示数据必须关闭（生产环境保留它会每次启动都写入演示租户/订单/设备）
SEED_DEMO_DATA=false

# 三个管理员口令：必须非空、长度 ≥ MIN_PASSWORD_LENGTH、且不在弱口令黑名单里
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(32))"
PLATFORM_ADMIN_PASSWORD=<替换为强口令>
PLATFORM_OPERATOR_PASSWORD=<替换为强口令>
MERCHANT_ADMIN_PASSWORD=<替换为强口令>
FACTORY_ADMIN_PASSWORD=<替换为强口令>

# JWT 签名密钥：占位值（含 dev-only / change-me）会被拒绝
JWT_SECRET_KEY=<python -c "import secrets;print(secrets.token_urlsafe(48))">

# 落库密钥的加密密钥（SECRET_ENCRYPTION_KEY）：生产环境**必须显式设置**。
# 留空时会从 JWT_SECRET_KEY 派生——一旦轮换 JWT 密钥，已存的云服务商
# SecretKey / 小程序 appSecret 将全部无法解密。
SECRET_ENCRYPTION_KEY=<32 字节以上的强随机值>

# 二维码签名密钥（京东 Wi-Fi 方案的 HMAC）
QR_SIGN_SECRET=<强随机值>

# CORS：生产环境不得包含 localhost / 127.0.0.1（启动期会拒绝）
CORS_ALLOWED_ORIGINS=https://your-domain.example.com

# ---------------------------------------------------------------------------
# 二、模拟通道必须关闭（生产环境启用会被拒绝启动）
# ---------------------------------------------------------------------------
#
# 这两项在开发/演示环境是**必要的可演示性**（离线跑通全流程），
# 在生产就是直接的安全漏洞：
#   * mock 短信 = 验证码回显在响应里 → 短信校验形同虚设
#   * mock 支付 = 支付接口直接把订单置为已支付 → 充值白送
# 因此 `APP_ENV=production` 时它们只能是 none；真实对接后再改为实际通道。
MINIAPP_SMS_PROVIDER=none
PAYMENT_PROVIDER=none

# ---------------------------------------------------------------------------
# 三、容器编排专属变量（只有 Compose 读它们，应用本身不读）
# ---------------------------------------------------------------------------

# 容器内数据库地址。
# ★ 刻意与 `.env` 的 `DATABASE_URL` 分开：
#   开发机的 DATABASE_URL 是**相对路径**（sqlite+aiosqlite:///./data/toyverse.db），
#   若被插值带进容器，SQLite 就落到镜像层而不是挂载卷，容器重建即丢数据。
# 默认（不设置时）：sqlite+aiosqlite:////data/toyverse.db（落在 app_data 卷）
# 用 PostgreSQL 时（需同时 --profile postgres）：
#   postgresql+asyncpg://toyverse:<POSTGRES_PASSWORD>@postgres:5432/toyverse_dev
# APP_DATABASE_URL=

# PostgreSQL（仅 --profile postgres 需要；留空时 postgres 镜像会拒绝初始化并报错）
POSTGRES_DB=toyverse_dev
POSTGRES_USER=toyverse
POSTGRES_PASSWORD=<替换为强口令>
POSTGRES_PORT=5432

# 对外端口
APP_PORT=8000
NGINX_PORT=8080

# ---------------------------------------------------------------------------
# 四、真实厂商对接（未配置时相关能力**安全失败**，不会伪造成功）
# ---------------------------------------------------------------------------
#
# ADR-07：未配置密钥的厂商一律返回 VENDOR_UNAVAILABLE 并写审计。
# 因此下面留空是**可用状态**（对应能力被明确禁用），而不是缺配置的故障。
# 需要真实设备生成 / 对话 / OTA 时再逐项填写。
#
# 集贤（4G 设备云）：JIXIAN_API_BASE / JIXIAN_ACCESS_KEY / JIXIAN_SECRET_KEY / JIXIAN_VENDOR_ID
# 京东云 JoyInside（Wi-Fi）：JOYINSIDE_API_BASE / JOYINSIDE_ACCESS_KEY / JOYINSIDE_SECRET_KEY
# 火山引擎（硬件对话智能体）：VOLCANO_API_BASE / VOLCANO_ACCESS_KEY / VOLCANO_SECRET_KEY / VOLCANO_APP_ID
# 百度智能云：BAIDU_API_BASE / BAIDU_API_KEY / BAIDU_SECRET_KEY
#
# 对象存储：默认 local（容器内 /data/storage，随 app_data 卷持久化）。
# 改用 S3 需自行实现 StorageBackend（当前 STORAGE_BACKEND=s3 会显式返回 503，不会假装可用）。
STORAGE_BACKEND=local

# ---------------------------------------------------------------------------
# 五、部署后自检（三条命令，缺一不可）
# ---------------------------------------------------------------------------
#
#   docker compose ps                      # 服务是否 healthy（不是只看 running）
#   make smoke                             # 全端点冒烟（按真实角色登录后逐端点请求）
#   python3 scripts/scan_secrets.py        # 确认没有弱口令/密钥进仓库
#
# 数据持久化验证（本阶段的验收项）：
#   docker compose down && docker compose up -d && make smoke
#   → 重启后演示数据仍在（说明 SQLite 落在 app_data 卷而不是容器层）
#
# 回滚：镜像按 `toyverse-cloud:<版本>` 打标签，改回上一个标签后
#   docker compose up -d --force-recreate
# 数据库回滚：`cd backend && alembic downgrade -1`（每个迁移都实现了 downgrade）
