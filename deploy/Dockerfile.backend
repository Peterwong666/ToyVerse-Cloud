# ============================================================
# ToyVerse Cloud — 后端 + 前端一体化镜像
#
# 多阶段构建：
#   builder  —— 安装 Python 依赖到独立目录
#   runtime  —— 仅复制依赖与源码，非 root 运行
#
# 前端为「零构建」ES Module 静态资源，无需 Node 构建步骤，
# 直接由 FastAPI 静态托管，因此镜像内不含 Node 工具链。
# ============================================================

# ------------------------------------------------------------
# 阶段一：依赖构建
# ------------------------------------------------------------
FROM python:3.12-slim AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /build

# 先只复制依赖声明，最大化利用 Docker 层缓存
COPY backend/requirements.txt ./requirements.txt

RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install -r requirements.txt

# ------------------------------------------------------------
# 阶段二：运行
# ------------------------------------------------------------
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    APP_ENV=production \
    HOST=0.0.0.0 \
    PORT=8000

# 创建非 root 用户
RUN groupadd --gid 10001 toyverse \
    && useradd --uid 10001 --gid toyverse --shell /sbin/nologin --create-home toyverse

# 复制虚拟环境
COPY --from=builder /opt/venv /opt/venv

WORKDIR /app

# 复制后端源码
COPY --chown=toyverse:toyverse backend/app ./app
COPY --chown=toyverse:toyverse backend/alembic ./alembic
COPY --chown=toyverse:toyverse backend/alembic.ini ./alembic.ini

# 复制前端静态资源（零构建，直接托管）
COPY --chown=toyverse:toyverse frontend ./frontend

# 数据目录（SQLite 与本地文件存储）
RUN mkdir -p /data/storage && chown -R toyverse:toyverse /data

USER toyverse

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=5).status == 200 else 1)"

# 启动前先执行数据库迁移，再拉起服务
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host ${HOST} --port ${PORT} --workers 4"]
