# ============================================================
# ToyVerse Cloud — 环境变量样例
# 使用方式：cp .env.example .env 然后按注释修改
# ⚠️ 安全提示：.env 已被 .gitignore 排除，请勿提交真实密钥
# ============================================================

# ------------------------------------------------------------
# 一、应用基础配置
# ------------------------------------------------------------
APP_NAME=ToyVerse Cloud
APP_ENV=development
DEBUG=true

# 服务监听
HOST=0.0.0.0
PORT=8000

# 前端跨域白名单（逗号分隔；本地开发默认）
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173

# ------------------------------------------------------------
# 二、数据库
# 默认 SQLite（零配置，克隆即可运行）
# 切换 PostgreSQL：把 DATABASE_URL 换成下面注释里的那行
# ------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/toyverse.db
# DATABASE_URL=postgresql+asyncpg://toyverse:toyverse_dev@localhost:5432/toyverse_dev

# 连接池（仅在 PostgreSQL 下生效；SQLite 忽略）
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# ------------------------------------------------------------
# 三、鉴权与安全
# ⚠️ 上线前必须替换为强随机值（至少 32 字节）
#    生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
# ------------------------------------------------------------
JWT_SECRET_KEY=dev-only-insecure-secret-change-me-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=toyverse-cloud

# Token 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# 密码策略
BCRYPT_ROUNDS=12
MIN_PASSWORD_LENGTH=8
# 首次登录是否强制改密
FORCE_PASSWORD_CHANGE_ON_FIRST_LOGIN=true

# 登录失败锁定策略（沿用早期实现的取值：5 次失败锁定 15 分钟）
MAX_LOGIN_FAILURES=5
LOCKOUT_MINUTES=15

# 外部厂商密钥的落库加密密钥（云服务商 SecretKey / 小程序 AppSecret）
# 留空时由 JWT_SECRET_KEY 派生；生产环境必须显式配置独立密钥，否则
# 「更换 JWT 密钥」会导致数据库中已加密的厂商密钥全部无法解密。
SECRET_ENCRYPTION_KEY=

# ------------------------------------------------------------
# 四、初始管理员账号
# ⚠️ 必须自行设置强密码；系统启动时校验，不满足则拒绝启动
#    绝不使用历史弱口令
# ------------------------------------------------------------
PLATFORM_ADMIN_ACCOUNT=admin
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NICKNAME=平台管理员

# 平台运营（可选）：可处理产品 / 订单 / 设备等日常业务，
# 但不能修改「客户档案 / 云服务商 / 产品模板」这类平台级配置。
# 账号留空则跳过该账号的初始化。
PLATFORM_OPERATOR_ACCOUNT=13812345678
PLATFORM_OPERATOR_PASSWORD=
PLATFORM_OPERATOR_NICKNAME=平台运营

MERCHANT_ADMIN_ACCOUNT=13812345679
MERCHANT_ADMIN_PASSWORD=
MERCHANT_ADMIN_NICKNAME=商户管理员

FACTORY_ADMIN_ACCOUNT=13600000000
FACTORY_ADMIN_PASSWORD=
FACTORY_ADMIN_NICKNAME=工厂管理员

# ------------------------------------------------------------
# 五、演示数据
# 是否在数据库为空时自动写入演示数据
# ------------------------------------------------------------
SEED_DEMO_DATA=true
# 演示二维码固定盐（用于可复现的演示数据）
DEMO_QR_SALT=toyverse-demo-salt

# ------------------------------------------------------------
# 六、二维码签名
# 京东 Wi-Fi 方案二维码格式：JD|{tenant_id}|{product_id}|{sn}|{sign}
# JX 使用 SN/IMEI/ICCID 明文拼接，无需签名
# ------------------------------------------------------------
QR_SIGN_SECRET=dev-only-qr-sign-secret-change-me
QR_CONFIRM_TOKEN_TTL_SECONDS=300

# ------------------------------------------------------------
# 七、设备在线判定
# 超过该窗口未收到心跳则判定为离线（沿用早期实现的 180 秒）
# ------------------------------------------------------------
HEARTBEAT_INTERVAL_SECONDS=30
ONLINE_WINDOW_SECONDS=180

# ------------------------------------------------------------
# 八、AI 能力配置
# AI_DEFAULT_PROVIDER 取值：mock | jixian | joyinside | volcano | baidu
# ⚠️ 默认 mock：完全离线可运行，无需任何厂商密钥
#    切换到真实厂商时，只需填写下面对应的密钥即可
#    未配置密钥的真实厂商会安全返回 VENDOR_UNAVAILABLE，不会伪造成功
# ------------------------------------------------------------
AI_DEFAULT_PROVIDER=mock

# 离线模拟引擎参数
# MOCK_ASR_MODE: echo（回显输入）| fixed（固定转写）
MOCK_ASR_MODE=echo
# MOCK_TTS_MODE: text（返回文本）| wav（生成占位音频）
MOCK_TTS_MODE=text
# 模拟响应延迟（毫秒），用于生成可复现的延迟基准
MOCK_LATENCY_MS=120
# 固定随机种子，保证演示与基准测试可复现
MOCK_RANDOM_SEED=20260916

# ------------------------------------------------------------
# 九、厂商密钥（留空即视为未接入）
# ------------------------------------------------------------

# 9.1 集贤系统（4G 方案 / ML307N 模组）
JIXIAN_API_BASE=
JIXIAN_ACCESS_KEY=
JIXIAN_SECRET_KEY=
JIXIAN_VENDOR_ID=
JIXIAN_APP_ID=
JIXIAN_TIMEOUT_SECONDS=10

# 9.2 京东云 JoyInside（Wi-Fi 方案 / ESP32-S3）
JOYINSIDE_API_BASE=
JOYINSIDE_ACCESS_KEY=
JOYINSIDE_SECRET_KEY=
JOYINSIDE_TENANT_ID=
JOYINSIDE_APP_ID=
JOYINSIDE_TIMEOUT_SECONDS=10

# 9.3 火山引擎（豆包大模型 / 语音）
VOLCANO_API_BASE=
VOLCANO_ACCESS_KEY=
VOLCANO_SECRET_KEY=
VOLCANO_APP_ID=
# 大模型接入点 ID（Endpoint ID）
VOLCANO_MODEL_ENDPOINT=
VOLCANO_TIMEOUT_SECONDS=30

# 火山引擎 IoT（硬件对话智能体 · 设备注册 Route B）
VOLCANO_IOT_INSTANCE_ID=
VOLCANO_IOT_PRODUCT_KEY=
VOLCANO_IOT_PRODUCT_SECRET=

# 9.4 百度智能云（文心一言 / 语音）
BAIDU_API_BASE=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BAIDU_APP_ID=
BAIDU_TIMEOUT_SECONDS=30

# ------------------------------------------------------------
# 十、对象存储（知识库文件 / OTA 固件包）
# 默认 local：落本地磁盘，无需 MinIO
# ------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/storage
STORAGE_PRESIGNED_TTL_SECONDS=3600

# 切换 MinIO / S3 时填写
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=true

# ------------------------------------------------------------
# 十一、可观测性
# ------------------------------------------------------------
LOG_LEVEL=INFO
# 是否输出 JSON 结构化日志（生产建议 true）
LOG_JSON=false
# 是否启用 Prometheus 指标
METRICS_ENABLED=true
